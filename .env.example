DATABASE_URL=postgresql://user:password@localhost:5432/csl01
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-bytes
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Register this exact URL as an Authorized redirect URI in Google Cloud.
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
FRONTEND_URL=http://localhost:8000/docs
# Local HTTP development only; set true when deploying over HTTPS.
AUTH_COOKIE_SECURE=false
ACCESS_TOKEN_MINUTES=180
REFRESH_TOKEN_DAYS=14

# Local HTTP development only: set AUTH_COOKIE_SECURE=true when using HTTPS.
# Exact frontend/API origins (comma-separated; include scheme and port).
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://your-site.example
